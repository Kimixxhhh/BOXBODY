; Godot 4.7 C# prototype
config_version=5

[application]
config/name="Field Kit Prototype"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/min_width=800
window/size/min_height=600
window/stretch/mode="canvas_items"

[dotnet]
project/assembly_name="FieldKit"

[input]
fire={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":1)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":4194321)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventKey,"physical_keycode":4194323)]}
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventKey,"physical_keycode":4194320)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventKey,"physical_keycode":4194322)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69)]}
reload={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":82)]}
throw={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":71)]}
weapon_prev={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":4)]}
weapon_next={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":5)]}
inventory={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194306)]}

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.92,0.93,0.94,1)
